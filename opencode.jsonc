{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "question": "allow",
      },
    },
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "text": {
              "verbosity": "low",
            },
            "textVerbosity": "low",
            "reasoningSummary": "concise",
            "personality": "pragmatic",
          },
        },
      },
    },
  },
  "references": {
    "mint-up-production": {
      "repository": "../../../projects/mint-up-corp",
      "branch": "main",
    },
  },
}
